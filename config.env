# ============================================================================
# KernelSU Action -- realme RMX3357 / GT Neo2T (RE5469, MT6893, project 21651)
# 非 GKI 内核 Linux 4.19.191
#
# 参数依据：设备实测（adb + /proc/config.gz）+ 上游官方
# config/nongki-4.19-susfs.env 交叉验证。详见 方案.md。
#
# 用法：覆盖 fork 根目录的 config.env，然后
#   Actions -> Build Kernel -> Run workflow，Config file to build 保持默认 "config.env"
# ============================================================================

# ⚠ 这一条【不起作用】，留着只是为了和上游档案保持同形，方便对读。
#   原因：config.sh:20 写的是  CONFIG_FILE=${CONFIG_ENV:-config.env}
#   —— 它读的是【环境变量】CONFIG_ENV，而工作流把环境变量接在
#   workflow_dispatch 的 "Config file to build" 输入上（build-kernel.yml 里
#   CONFIG_ENV: ${{ inputs.config }}），不是从这个文件里读。
#   所以本文件里这一行永远不会被 cfg_read 读到（它也不在 config.sh 的
#   DEFAULTS 表里）。真正决定用哪个配置文件的，是派发时那个输入框。
CONFIG_ENV=config.env

# ---------------------------------------------------------------- 内核源码 ---
# 本机机型是 MT6893（Dimensity 1200），不是骁龙 870。
# 该分支 Makefile 实测为 4.19.191，与设备 uname -r 一致。
KERNEL_SOURCE=https://github.com/realme-mt6893-dev/android_kernel_realme_mt6893
KERNEL_SOURCE_BRANCH=thirteen

# 设备 CONFIG_LOCALVERSION 为空、LOCALVERSION_AUTO 未设，与 mt6893_defconfig 一致。
# 另一个候选 cupida_defconfig 是 -Bluelight，会把 vermagic 改掉，不能用。
KERNEL_CONFIG=mt6893_defconfig

# 原厂 boot 的内核段是纯 gzip、流后 0 字节（无追加 DTB），所以是 Image.gz。
# 注意：设备 DTB 在 boot 镜像 header v2 的独立 dtb 段里（dtb_size=210513），
# 不在内核里，也不需要我们生成 —— 重打包时原样保留即可。
KERNEL_IMAGE_NAME=Image.gz
ARCH=arm64

# ★★ 必须留空！
# 构建脚本会执行 kconf_set CONFIG_LOCALVERSION "-${KERNEL_NAME}"，
# 一旦填了值，内核 release 就不再是 4.19.191+，而 CONFIG_MODVERSIONS=y 会按
# vermagic 校验模块 → /vendor/lib/modules/*.ko 全部加载失败（WiFi/蓝牙/相机全废）。
KERNEL_NAME=
ADD_LOCALVERSION_TO_FILENAME=false

# ★★ CUSTOM_CMDS 里的 CLANG_TRIPLE 是【承重项】，不是"跟上游一致的惯例"。
#
# 本树 Makefile:528-533 有一个在解析阶段就求值的守卫：
#   ifeq ($(cc-name),clang)
#   ifneq ($(CROSS_COMPILE),)
#   CLANG_TRIPLE	?= $(CROSS_COMPILE)
#   CLANG_FLAGS	+= --target=$(notdir $(CLANG_TRIPLE:%-=%))
#   ifeq ($(shell $(srctree)/scripts/clang-android.sh $(CC) $(CLANG_FLAGS)), y)
#   $(error "Clang with Android --target detected. Did you specify CLANG_TRIPLE?")
#   endif
#
# 为什么一定会触发：
#   - 工作流在 ENABLE_GCC_ARM64=true 时会设 CROSS_COMPILE=.../aarch64-linux-android-
#     （见 toolchain.sh），于是 ifneq 成立
#   - CLANG_TRIPLE ?= 拿到那个 android 前缀 → --target=aarch64-linux-android
#   - AOSP 预编译 clang 自带 __ANDROID__ → clang-android.sh 输出 y → 守卫触发
#
# 关键：$(error) 在 Makefile 解析阶段就求值，所以【任何目标都会失败，
# 包括 make defconfig】，而报错信息是 "defconfig generation failed" ——
# 它会把你引向 defconfig，但真正的原因是 toolchain triple。
#
# 覆盖成非 Android 的 triple 即可。build.sh 会把 CUSTOM_CMDS 拼到 make 命令行上，
# 而命令行变量优先于 ?=：→ --target=aarch64-linux-gnu → 不再定义 __ANDROID__ → 放行。
#
# 换句话说：如果只换 KERNEL_SOURCE 而不动这一行，就会在同一个地方倒下。
EXTRA_CMDS:LD=ld.lld
CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-

# ------------------------------------------------------------------ 工具链 ---
# 原厂用 clang 11.0.1(r383902)；r450784e 是上游为 4.x 树验证过的安全选择。
CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r450784e

USE_CUSTOM_CLANG=false
CUSTOM_CLANG_SOURCE=
CUSTOM_CLANG_BRANCH=

# 4.x 树用 LLVM 集成汇编器容易挂，保持关闭。
USE_LLVM=false

ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true
USE_CUSTOM_GCC_64=false
CUSTOM_GCC_64_SOURCE=
CUSTOM_GCC_64_BRANCH=
CUSTOM_GCC_64_BIN=aarch64-linux-android-
USE_CUSTOM_GCC_32=false
CUSTOM_GCC_32_SOURCE=
CUSTOM_GCC_32_BRANCH=
CUSTOM_GCC_32_BIN=arm-linux-androideabi-

# ---------------------------------------------------------------- KernelSU ---
# 设备上装的管理器是 com.sukisu.ultra，所以内核侧必须是 sukisu-ultra。
KSU_VARIANT=sukisu-ultra

# ★ KSU_REF=builtin 是【非 GKI 的硬需求】，与要不要 SUSFS 无关。
#   kernelsu.sh 的注册表：sukisu-ultra = repo|setup_ref|dir|modern_ref|legacy_ref|...
#   modern_ref=main（模块化 v4 树，需内核 ≥5.10），legacy_ref=builtin。
#   ksu_install 里 `ver_ge "$kver" "5.10"` 判假时取 legacy_ref —— 我们 4.19，
#   所以只能走 builtin（源码内置树）。
#   它同时是唯一声明 SUSFS Kconfig 的 ref —— 这正是下面要显式关掉那个宏的原因。
#
# ⚠ 这个键在本文件里只能出现【一次】。cfg_read 用 `head -n1` 只取第一处匹配，
#   重复出现时后面那次是死代码 —— 文件里明明有那一行，改它却毫无反应，
#   而且不会有任何报错。check_config.py 已把「重复键」列为硬错误。
KSU_REF=builtin

# 4.x 上 kprobes 不可靠（症状是"装上了但 su 没反应"），manual 才是对的。
KSU_HOOK_MODE=manual

KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

# ------------------------------------------------------------------- SUSFS ---
# ★★ 精简版：关闭 SUSFS，先保证 root 能起来。这是本轮的主要决策。
#
# ★ SUSFS_BRANCH 留 auto 是对的（重新打开 SUSFS 时用）。
#   patches.sh 的 susfs_branch_for 把 4.19 映射到 susfs4ksu 的 kernel-4.19 分支，
#   并在 clone 之前用 ref_exists 校验它真实存在 —— 不存在会立刻 die 并列出
#   可用分支，不会静默跳过。
#   （上游官方 config/nongki-4.19-susfs.env 是开启态的参考档案，已逐项核对过差异。）
#
# 关掉之后会发生什么（已逐项核对源码，不是推测）：
#
#   1. susfs_apply() 不跑 -> 不拷 linux/susfs.h、不打 50_add_susfs_in_kernel-4.19.patch
#   2. susfs_defconfig() 不跑（build.sh:36 有 is_true 门控），所以 CONFIG_KSU_SUSFS*
#      不会被它打开
#   3. ⚠ 但 builtin ref 的 Kconfig 里 `config KSU_SUSFS` 是 **default y**，
#      而它的依赖 THREAD_INFO_IN_TASK 在本设备为 y —— 所以它【会】被默认打开。
#      已核对 kernel/kernel_includes.h:76-79：
#          #ifdef CONFIG_KSU_SUSFS
#          #include <linux/susfs.h>
#          #include <linux/susfs_def.h>
#          #endif
#      宏一旦为 y，就会去找一个没人拷进去的头文件 -> 编译失败。
#      => 所以 EXTRA_DEFCONFIG 里【必须】显式 CONFIG_KSU_SUSFS=n（见文件末尾）。
#         EXTRA_DEFCONFIG 在 build.sh 里于 susfs_defconfig 之后应用，能覆盖默认值。
#   4. 已用脚本扫过 builtin ref 全部 67 个源文件：susfs_* 引用 78 处，
#      其中未受 CONFIG_KSU_SUSFS 守卫的 **0** 处 -> 关掉宏不会留下悬空引用。
#
# 想要 SUSFS 时的回滚路径：把 ENABLE_SUSFS 改回 true 即可。
# 配套的补丁适配（patches/50_add_susfs_in_kernel-4.19.patch +
# scripts/patches.sh 里的 in-repo 覆盖）已经验证可用，run #6 的
# "Apply kernel patches" 就是靠它才过的。
ENABLE_SUSFS=false
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_BRANCH=auto

# -------------------------------------------------------------- 额外补丁 ---
# path_umount() 是 5.9 才引入的，4.19 必须回移，否则 KernelSU 无法在 root 检测前
# 卸载自己的 overlay。**保留开启** —— 它已证明能干净打上，且是非 GKI 的硬需求。
ENABLE_PATH_UMOUNT=true

# ★ 精简版：一并关闭。
# 它依赖 SUSFS —— 69_hide_stuff.patch 的上下文里有这么一行：
#     extern void susfs_sus_ino_for_show_map_vma(unsigned long ino, ...);
# 这行是 SUSFS 的 50.patch 加进去的。SUSFS 关掉后它就没有可匹配的上下文了。
# 它本身是软失败（patches.sh:299 `|| warn ... continuing`），失败不会中断构建，
# 但会留噪音；更麻烦的是 run #6 里它是"带 fuzz"应用的，可能改到了别的位置。
ENABLE_HIDE_STUFF=false
ENABLE_KPM=false

# ----------------------------------------------------------------- Kconfig ---
ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=true
DISABLE_LTO=false
DISABLE_CC_WERROR=true

# ★★ 格式要求：构建脚本只认 "CONFIG_X=值"，值写 n 才会被转成 "# CONFIG_X is not set"。
#    直接写 "# CONFIG_X is not set" 会被判格式错误并【跳过】——
#    注意：不是静默跳过。build.sh:73 会 warn，lib.sh:31 在 CI 里打 ::warning::，
#    运行页面上能看到一条注解。所以这一项白写了，但你能看见，不会无声无息。
#
#  CONFIG_BUILD_ARM64_APPENDED_DTB_IMAGE=n
#      设备此项未开启。开着会把 DTB 追加进内核（变成 Image.gz-dtb），
#      与 KERNEL_IMAGE_NAME=Image.gz 不符，也和 boot 镜像自带的 dtb 段重复。
#
#  CONFIG_MODULE_SIG_FORCE=n
#      设备此项为 y，CONFIG_MODULE_SIG_KEY="certs/signing_key.pem"；
#      但公开源码树 certs/ 里没有 signing_key.pem，重建会生成新随机密钥，
#      原厂签名的 /vendor/lib/modules/*.ko 会验签失败，FORCE=y 时直接拒绝加载。
#      关闭后未知密钥按 -ENOKEY 放行，原厂模块可正常加载。
#
#  CONFIG_KALLSYMS / CONFIG_KALLSYMS_ALL
#      非 GKI 内核的 KernelSU 需要它们做符号查找（SukiSU 官方文档明确要求）。
#      KALLSYMS 设备已是 y；KALLSYMS_ALL 设备是 n，这里补上。
#
#  ★ CONFIG_KSU_SUSFS=n
#      见上面 ENABLE_SUSFS 那段。builtin ref 的 Kconfig 把这个符号设成 default y，
#      不显式关掉的话，kernel_includes.h 会去 include 一个没人拷进来的
#      linux/susfs.h。**这是本轮最容易被忽略的一处**：光设 ENABLE_SUSFS=false
#      并不够，因为那只管住了 susfs_defconfig，管不住 Kconfig 的 default。
#
#  ★ CONFIG_DEBUG_INFO_DWARF4=y
#      本轮新加，修的是 run #6 在 Build kernel 步的失败。原因链已逐环核对源码：
#        - stock/mt6893_defconfig:5887 显式写着 CONFIG_DEBUG_INFO=y，
#          而 DEBUG_INFO_DWARF4 未设（设备实测 # CONFIG_DEBUG_INFO_DWARF4 is not set）
#        - 本树顶层 Makefile:826-828（在 ifdef CONFIG_DEBUG_INFO 之内）
#              ifneq ($(LLVM_IAS),1)
#              KBUILD_AFLAGS  += -Wa,-gdwarf-2
#              endif
#          —— 是 **KBUILD_AFLAGS**，只作用于 .S 汇编，救不到 .c
#        - 本树顶层 Makefile:831-833
#              ifdef CONFIG_DEBUG_INFO_DWARF4
#              KBUILD_CFLAGS  += $(call cc-option, -gdwarf-4,)
#              endif
#        - scripts/Makefile.lib:94-96
#              orig_c_flags = $(KBUILD_CPPFLAGS) $(KBUILD_CFLAGS) ...
#              _c_flags     = $(filter-out $(CFLAGS_REMOVE_$(basetarget).o), $(orig_c_flags))
#          → __c_flags → c_flags；scripts/Makefile.build:171
#              cmd_cc_o_c = $(CC) $(c_flags) -c -o $@ $<
#          —— 所以 KBUILD_CFLAGS 确实到达每一个 .c 的编译
#        - arch/arm64/kernel/vdso/Makefile:14
#              obj-vdso := vgettimeofday.o note.o sigreturn.o
#          —— 三者中【只有 vgettimeofday 是 .c】。这正好解释了 run #6 的报错
#             为什么**恰好只有一个文件**，而不是整片 vDSO 全挂。
#        - clang 14 默认发 DWARF 5（`.file 0 "..."`），老 GNU as 只认 ≤4：
#              /tmp/vgettimeofday-6d914f.s:3: Error: file number less than one
#              clang-14: error: assembler command failed with exit code 1
#      加上这一项后 Makefile 会向 C 编译传 -gdwarf-4，与老汇编器兼容。
#      （lib/Kconfig.debug:204 有该符号声明、depends on DEBUG_INFO，依赖已满足；
#        不是"defconfig 里写了但 Kconfig 没有"的静默丢弃情形。）
EXTRA_DEFCONFIG=CONFIG_KALLSYMS=y CONFIG_KALLSYMS_ALL=y CONFIG_BUILD_ARM64_APPENDED_DTB_IMAGE=n CONFIG_MODULE_SIG_FORCE=n CONFIG_KSU_SUSFS=n CONFIG_DEBUG_INFO_DWARF4=y

# ---------------------------------------------------------------- AnyKernel3 ---
USE_CUSTOM_ANYKERNEL3=false
CUSTOM_ANYKERNEL3_SOURCE=
CUSTOM_ANYKERNEL3_BRANCH=

# ------------------------------------------------------------------ 打包 ---
# 设备专属 DTB 在 boot 镜像的 dtb 段里；只换内核、不动 dtb 才是对的。
NEED_DTBO=false

# ★★ 必须保持 false！
# 仓库里没有 tools/unpack_bootimg.py 和 tools/mkbootimg.py，也没有任何脚本或
# 工作流步骤会去创建它们。一旦设成 true，package.sh 会在
#   [ -f "${WORKSPACE}/tools/unpack_bootimg.py" ] || die "mkbootimg tools not found"
# 直接失败 —— 而且是在"Package artifacts"这一步，等于整个构建白跑、连
# AnyKernel3 都拿不到。上游官方 4.19 档案同样是 false。
#
# 要可 fastboot 的 boot.img，请用本目录的 repack_boot.py 在本地做
# （已用原厂镜像做往返测试，输出逐字节相同），见 方案.md 步骤 B。
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=

# ------------------------------------------------------------------ Runner ---
ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
